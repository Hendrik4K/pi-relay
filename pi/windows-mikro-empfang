#!/bin/sh
# Empfängt das Windows-Mikrofon von Pi Relay über SSH und spielt es ins virtuelle Mikrofon
# „Windows-Mikrofon (Pi Relay)“ (PipeWire-Knoten windows-mikrofon, angelegt von windows-mikrofon.conf).
# Receives the Windows microphone from Pi Relay over SSH and plays it into the virtual microphone
# "Windows-Mikrofon (Pi Relay)" (PipeWire node windows-mikrofon, created by windows-mikrofon.conf).
#
#   windows-mikro-empfang            liest rohes PCM von stdin: s16le, 48000 Hz, 1 Kanal (mono)
#   windows-mikro-empfang --status   „bereit“ (Exit 0) oder Fehlertext (Exit 1)
#   windows-mikro-empfang --pegel    hört 3 s am virtuellen Mikrofon mit und meldet den Pegel (0 = Stille)
#
# Ende des Datenstroms (SSH zu) beendet den Empfang. Kein Port, keine Anmeldung außer SSH.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
KNOTEN=windows-mikrofon

if ! pw-cli ls Node 2>/dev/null | grep -q "node.name = \"$KNOTEN\""; then
    echo "virtuelles Mikrofon $KNOTEN fehlt (PipeWire-Konfiguration windows-mikrofon.conf) / virtual microphone missing" >&2
    exit 1
fi
if [ "${1:-}" = "--pegel" ]; then
    timeout 3 pw-record --raw --target "$KNOTEN" --format s16 --rate 48000 --channels 1 - 2>/dev/null | python3 -I -c '
import sys, struct, math
d = sys.stdin.buffer.read(); n = len(d) // 2
s = struct.unpack("<%dh" % n, d[:n * 2]) if n else ()
rms = int(math.sqrt(sum(x * x for x in s) / n)) if n else 0
print("Pegel %d (Stille unter 50, Sprechen meist 500-8000)" % rms)'
    exit 0
fi
if [ "${1:-}" = "--status" ]; then
    echo "bereit (ready)"
    exit 0
fi
# als Standard-Mikrofon setzen, damit Programme es ohne Auswahl nehmen
ID=$(pw-cli ls Node | awk -v k="node.name = \"$KNOTEN\"" '/^\s*id [0-9]+/{id=$2; sub(",","",id)} index($0,k){print id; exit}')
[ -n "$ID" ] && wpctl set-default "$ID" 2>/dev/null
# PipeWire hängt Wiedergabeströme nicht von selbst an eine Mikrofon-Quelle → selbst verbinden
exec 3<&0
pw-cat --playback --raw --format s16 --rate 48000 --channels 1 --latency 40ms \
    -P '{ node.name = windows-mikro-strom node.autoconnect = false }' - <&3 &
STROM=$!
trap 'kill $STROM 2>/dev/null' INT TERM HUP
for i in $(seq 1 50); do
    pw-link windows-mikro-strom:output_MONO "$KNOTEN:input_MONO" 2>/dev/null && break
    sleep 0.1
done
wait $STROM
