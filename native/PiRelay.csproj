<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Keep local build folders out of the published binaries. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/PiRelay</PathMap>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PiRelay</AssemblyName>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationIcon>Assets/PiRelay.ico</ApplicationIcon>
    <Version>1.7.7</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <Content Include="../dist/client/**/*" Link="ui/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="remote_worker.py" />
    <Content Include="Assets/PiRelay.ico" Link="PiRelay.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../node_modules/@novnc/novnc/LICENSE.txt" Link="licenses/noVNC-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../node_modules/@novnc/novnc/docs/LICENSE.MPL-2.0" Link="licenses/MPL-2.0.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../node_modules/@novnc/novnc/vendor/pako/LICENSE" Link="licenses/pako-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
